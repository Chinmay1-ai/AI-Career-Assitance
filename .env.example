# =============================================================================
# AI Career Assistant — environment template
# Copy values into the files noted below. Do NOT commit real secrets to git.
# =============================================================================

# --- Backend: copy to backend/.env ---
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string (Prisma)
# Example: postgresql://USER:PASSWORD@localhost:5432/ai_career_assistant?schema=public
DATABASE_URL=

# Clerk secret key (backend — for future protected API routes)
# From Clerk Dashboard → API Keys → Secret keys
CLERK_SECRET_KEY=

# Google Gemini — backend only (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional; default in code is gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# --- Local facial-expression service (backend only) ---
EMOTION_SERVICE_URL=http://127.0.0.1:5001

# --- Frontend: copy to frontend/.env.local (Vite only exposes VITE_* to the browser) ---
# Clerk publishable key (safe for frontend)
# From Clerk Dashboard → API Keys → Publishable key
# Note: NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is for Next.js only — this project uses:
VITE_CLERK_PUBLISHABLE_KEY=

# Optional: backend URL if not using Vite dev proxy
# VITE_API_URL=http://localhost:5000
